# Flutter Interview Platform - Environment Configuration
# Copy this file to .env and update with your values
# IMPORTANT: Add .env to .gitignore to prevent committing secrets!

# ============================================
# Application Environment
# ============================================

# Environment type: 'development' or 'live'
APP_ENV=development

# Enable/disable debug mode (set to false in production)
APP_DEBUG=true

# Application URL
APP_URL=http://localhost:8000

# ============================================
# Database Configuration
# ============================================

# Database host (usually 'localhost' for shared hosting)
DB_HOST=localhost

# Database port (default MySQL port is 3306)
DB_PORT=3306

# Database name
DB_DATABASE=interview_platform

# Database user
DB_USER=root

# Database password (leave empty for default or no password)
DB_PASSWORD=

# Database charset (usually utf8mb4)
DB_CHARSET=utf8mb4

# ============================================
# Admin Credentials
# ============================================

# Admin username for logging into admin dashboard
ADMIN_USERNAME=admin

# Admin password (will be hashed)
# SECURITY: Use a strong password in production!
# Generate strong password: openssl rand -hex 16
ADMIN_PASSWORD=password

# Secret key for encryption and sessions
# Generate: php -r 'echo bin2hex(random_bytes(32));'
# or: openssl rand -hex 32
SECRET_KEY=change_me_to_random_value

# ============================================
# Server Configuration
# ============================================

# Server name/domain
SERVER_NAME=localhost

# Server admin email
SERVER_ADMIN=admin@localhost

# ============================================
# Session Configuration
# ============================================

# Session lifetime in seconds (3600 = 1 hour)
SESSION_LIFETIME=3600

# Use only cookies for sessions (recommended)
SESSION_USE_ONLY_COOKIES=true

# ============================================
# Logging Configuration
# ============================================

# Log channel: 'file' or 'syslog'
LOG_CHANNEL=file

# Log level: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=debug

# ============================================
# Production Security Settings
# ============================================

# Set to true in production to enable security headers
ENABLE_SECURITY_HEADERS=false

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Rate limiting: number of requests per minute
RATE_LIMIT_REQUESTS=60

# Enable HTTPS only (set to true after SSL certificate is installed)
FORCE_HTTPS=false

# ============================================
# Email Configuration (Optional)
# ============================================

# Mail driver: 'smtp' or 'mail'
MAIL_DRIVER=mail

# SMTP host
MAIL_HOST=smtp.mailtrap.io

# SMTP port
MAIL_PORT=2525

# SMTP username
MAIL_USERNAME=

# SMTP password
MAIL_PASSWORD=

# From email address
MAIL_FROM_ADDRESS=noreply@example.com

# From email name
MAIL_FROM_NAME="Interview Platform"
